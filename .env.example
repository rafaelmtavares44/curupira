# Copie para `.env` e preencha. `.env` esta no .gitignore.
# NUNCA comite este arquivo preenchido. O pre-commit tem detect-secrets, mas a
# barreira nao substitui o cuidado.

CURUPIRA_ANTHROPIC_API_KEY=
CURUPIRA_OPENAI_API_KEY=
CURUPIRA_GOOGLE_API_KEY=

# Diretorio de saida das rodadas (fora do git)
CURUPIRA_RUNS_DIR=./runs
